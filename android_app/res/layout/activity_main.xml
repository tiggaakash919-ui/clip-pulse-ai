<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/frame">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/frame_surface"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/brand"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Status Dot Indicator -->
        <View
            android:id="@+id/statusIndicator"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/button_bg" />

        <!-- Server Change Button -->
        <Button
            android:id="@+id/btnServer"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:text="@string/btn_settings"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- Refresh Button -->
        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/btn_refresh"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>

    <!-- Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="@color/brand"
        android:visibility="gone" />

    <!-- Main Content Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- PeakCut Web View -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Error Layout (Shown when backend is offline) -->
        <ScrollView
            android:id="@+id/errorLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone"
            android:background="@color/frame">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PeakCut Engine Offline"
                    android:textColor="@color/brand"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvErrorMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/error_hint"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tvRetryCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto-reconnecting in 3s..."
                    android:textColor="@color/brand"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="18dp" />

                <!-- SECTION 1: DUSRE PHONE KE LIYE (HOTSPOT & WI-FI) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/frame_surface"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Agar Dusre Phone me chala rahe hain:"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phone 1 ka Hotspot on karein ya dono ko ek hi Wi-Fi se jodein:"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnHotspot"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="@string/btn_hotspot"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:background="@drawable/button_bg"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/btnScanNetwork"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="@string/btn_scan_network"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:background="@drawable/button_bg"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/btnEnterIp"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="@string/btn_enter_ip"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:background="@drawable/button_bg" />
                </LinearLayout>

                <!-- SECTION 2: HOST PHONE PAR TERMUX CONTROLS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/frame_surface"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Agar Isi Phone par Termux chal raha hai:"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="10dp" />

                    <Button
                        android:id="@+id/btnRetry"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="@string/btn_retry"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:background="@drawable/button_bg"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/btnCopyCmd"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="@string/btn_copy_cmd"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:background="@drawable/button_bg"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/btnGuide"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="@string/btn_guide"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:background="@drawable/button_bg" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
